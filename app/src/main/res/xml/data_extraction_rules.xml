<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tracediary_app_password_prefs.xml"/>
        <exclude domain="sharedpref" path="tracediary_credentials_prefs.xml"/>
        <exclude domain="file" path="ai-model/"/>
        <exclude domain="database" path="tracediary_ai.db"/>
        <exclude domain="database" path="tracediary_ai.db-shm"/>
        <exclude domain="database" path="tracediary_ai.db-wal"/>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tracediary_app_password_prefs.xml"/>
        <exclude domain="sharedpref" path="tracediary_credentials_prefs.xml"/>
        <exclude domain="file" path="ai-model/"/>
        <exclude domain="database" path="tracediary_ai.db"/>
        <exclude domain="database" path="tracediary_ai.db-shm"/>
        <exclude domain="database" path="tracediary_ai.db-wal"/>
    </device-transfer>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>
